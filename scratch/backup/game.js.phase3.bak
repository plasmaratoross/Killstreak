          new FloatingText(this.player.x, this.player.y - 45, I18n ? (I18n.getLanguage() === "vi" ? "ĐẠI HỒNG THỦY OMNITIDAL!" : "OMNITIDAL APOCALYPSE!") : "OMNITIDAL APOCALYPSE!", "#ffffff", 22)
        );

        if (this.callbacks.onCutsceneEnd) {
          this.callbacks.onCutsceneEnd();
