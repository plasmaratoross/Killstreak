    startPhase17Cutscene() {
      this.isCutsceneActive = true;
      this.cutsceneIndex = 0;
      this.cutsceneTimer = 0;
      this.cutsceneType = "devourer_p17";
      this.cutsceneDialogue = this.getCutsceneDialogue();

      // Immediately grant All Devourer badge
      if (!this.saveData.achievements.includes("all_devourer")) {
        this.saveData.achievements.push("all_devourer");
        if (!this.saveData.badges.includes("all_devourer")) {
          this.saveData.badges.push("all_devourer");
        }
        Storage.save(this.saveData);
        if (this.callbacks.onBadgesUpdated) {
          this.callbacks.onBadgesUpdated(this.saveData.badges);
        }
      }

      this.camera.shake(12, 0.5);
      if (this.callbacks.onCutsceneStart) {
        this.callbacks.onCutsceneStart(this.cutsceneDialogue[0]);
      }
    }

    advanceCutscene() {
      if (!this.isCutsceneActive) return;
      this.cutsceneIndex++;
      if (this.cutsceneIndex >= this.cutsceneDialogue.length) {
        this.finishCutscene();
      } else {
        this.camera.shake(6, 0.25);
        const isAq = this.cutsceneType && this.cutsceneType.startsWith("aquatic");
        const isSoil = this.cutsceneType && this.cutsceneType.startsWith("soil");
        const isMet = this.cutsceneType && this.cutsceneType.startsWith("metallic");
        const isFlora = this.cutsceneType && this.cutsceneType.startsWith("flora");
        const isHell = this.cutsceneType && this.cutsceneType.startsWith("hellfire");
        for (let i = 0; i < 20; i++) {
          const angle = Math.random() * Math.PI * 2;
          const speed = 70 + Math.random() * 120;
          let pColor;
          if (isHell) {
            pColor = i % 2 === 0 ? "#ef4444" : "#fbbf24";
          } else if (isFlora) {
            pColor = i % 2 === 0 ? "#4ade80" : "#22c55e";
          } else if (isMet) {
            pColor = i % 2 === 0 ? "#ffffff" : "#cbd5e1";
          } else if (isSoil) {
            pColor = i % 3 === 0 ? "#fef08a" : (i % 3 === 1 ? "#f59e0b" : "#78350f");
          } else if (isAq) {
            pColor = i % 2 === 0 ? "#06b6d4" : "#ffffff";
          } else {
            pColor = "#facc15";
          }
          this.particles.push(
            new Particle(this.player.x, this.player.y, Math.cos(angle) * speed, Math.sin(angle) * speed, pColor, 4, 0.45)
          );
        }
        if (this.callbacks.onCutsceneStep) {
          this.callbacks.onCutsceneStep(this.cutsceneDialogue[this.cutsceneIndex]);
        }
      }
    }

    skipCutscene() {
      if (this.isCutsceneActive) {
        this.finishCutscene();
      }
    }

    finishCutscene() {
      this.isCutsceneActive = false;

      if (this.cutsceneType === "aquatic_unlock") {
        this.saveData.aquaticUnlockCutsceneSeen = true;
        Storage.save(this.saveData);

        this.camera.shake(14, 0.6);
        for (let i = 0; i < 60; i++) {
          const angle = Math.random() * Math.PI * 2;
          const speed = 90 + Math.random() * 200;
          const color = i % 2 === 0 ? "#06b6d4" : "#38bdf8";
          this.particles.push(
            new Particle(this.player.x, this.player.y, Math.cos(angle) * speed, Math.sin(angle) * speed, color, 4.5, 0.6)
          );
        }

        const I18n = window.Killstreak && window.Killstreak.I18n;
        this.floatingTexts.push(
          new FloatingText(this.player.x, this.player.y - 45, I18n ? I18n.t("floating.aquatic_unlocked") : "AQUATIC UNLOCKED!", "#06b6d4", 20)
        );

        if (this.callbacks.onCutsceneEnd) {
          this.callbacks.onCutsceneEnd();
        }
        if (this.callbacks.onToast) {
          const tTitle = I18n ? I18n.t("toasts.aquatic_unlock_title") : "WEAPON UNLOCKED";
          const tDesc = I18n ? I18n.t("toasts.aquatic_unlock_desc") : "Aquatic — The Drowning Tide is now available!";
          this.callbacks.onToast(tTitle, tDesc, "🌊");
        }
        return;
      }

      if (this.cutsceneType === "aquatic_p13") {
        this.saveData.aquaticPhase13CutsceneSeen = true;
        this.unlockAchievement("aquatic_ascended");
        Storage.save(this.saveData);

        this.camera.shake(20, 1.0);
        for (let i = 0; i < 90; i++) {
          const angle = Math.random() * Math.PI * 2;
          const speed = 120 + Math.random() * 280;
          const color = i % 2 === 0 ? "#ffffff" : "#06b6d4";
          this.particles.push(
            new Particle(this.player.x, this.player.y, Math.cos(angle) * speed, Math.sin(angle) * speed, color, 5.5, 0.8)
          );
        }

        const I18n = window.Killstreak && window.Killstreak.I18n;
